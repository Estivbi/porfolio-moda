---
// components/projects/ProjectFilter.astro - Filtro de proyectos
const categories = [
  { id: 'todos', label: 'Todos' },
  { id: 'portadas', label: 'Portadas de Revista' },
  { id: 'marcas', label: 'Marcas' },
  { id: 'artistas', label: 'Artistas' },
  { id: 'estudio', label: 'Estudio' },
  { id: 'editorial', label: 'Editorial' }
];
---

<div class="flex flex-wrap gap-3 mb-12">
  {categories.map((cat, index) => (
    <button 
      data-filter={cat.id}
      class={`subtitle px-6 py-2 border transition-all duration-300 ${index === 0 ? 'active' : ''}`}
      style={`
        border-color: var(--moda-stone);
      `}
    >
      {cat.label}
    </button>
  ))}
</div>

<style>
  button {
    color: var(--moda-charcoal);
  }

  button:hover {
    border-color: var(--moda-charcoal);
    background-color: var(--moda-charcoal);
    color: var(--moda-cream);
  }

  button.active {
    background-color: var(--moda-charcoal);
    color: var(--moda-cream);
    border-color: var(--moda-charcoal);
  }
</style>
