---
import { Image } from 'astro:assets';

interface Props {
  project: {
    id: number;
    title: string;
    category: string;
    cover: any;
    description: string;
  };
  featured?: boolean;
  class?: string;
}

const { project, featured = false, class: className } = Astro.props;

// Detectar si cover es una imagen importada o una URL string
const isImportedImage = project.cover && typeof project.cover === 'object' && 'src' in project.cover;

// Aspect ratio según el proyecto
const getAspectRatio = () => {
  if (project.id === 5 || project.id === 6) return 'aspect-[2/3]';
  if (featured) return 'aspect-[3/4]';
  return 'aspect-square';
};
---

<div 
  data-category={project.category}
  class={`group relative overflow-hidden ${className}`}
>
  <!-- Imagen optimizada con Astro -->
  <div class={`relative overflow-hidden flex items-center justify-center ${getAspectRatio()}`} style="background-color: #F5F5F5;">
    {isImportedImage ? (
      <Image 
        src={project.cover} 
        alt={project.title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    ) : (
      <img 
        src={project.cover} 
        alt={project.title}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        loading="lazy"
      />
    )}
  </div>

  <!-- Pie de página con descripción -->
  <div class="p-6 md:p-8" style="background-color: #FFFFFF;">
    <p class="text-xs uppercase tracking-widest mb-3" style="letter-spacing: 0.1em; color: #808080;">
      {project.category}
    </p>
    <h3 class="font-serif text-xl md:text-2xl mb-3 leading-tight" style="color: #000000;">
      {project.title}
    </h3>
    <p class="text-sm leading-relaxed" style="color: #808080;">
      {project.description}
    </p>
  </div>
</div>
