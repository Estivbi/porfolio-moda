---
// components/Home.astro - Página principal (la usan las versiones ES y EN)
import Layout from '../layouts/Layout.astro';
import Navbar from './layout/Navbar.astro';
import Hero from './sections/Hero.astro';
import Presentation from './sections/Presentation.astro';
import Projects from './sections/Projects.astro';
import About from './sections/About.astro';
import Contact from './sections/Contact.astro';
import Footer from './layout/Footer.astro';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
---

<Layout lang={lang}>
  <Navbar lang={lang} />
  <Hero lang={lang} />
  <Presentation lang={lang} />
  <Projects lang={lang} />
  <About lang={lang} />
  <Contact lang={lang} />
  <Footer lang={lang} />
</Layout>
