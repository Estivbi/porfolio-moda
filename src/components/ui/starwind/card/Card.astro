---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"div"> & VariantProps<typeof card>;

export const card = tv({
  base: [
    "bg-white text-black flex flex-col rounded-none transition-all duration-500",
    "has-data-[slot=card-footer]:pb-0 has-[>img:first-child]:pt-0",
    "*:[img:first-child]:rounded-none *:[img:last-child]:rounded-none",
  ],
  variants: {
    size: {
      default: "gap-0 p-0",
      sm: "gap-4 p-4 text-sm",
      lg: "gap-6 p-6",
    },
    variant: {
      default: "bg-white border border-gray-light hover:border-gray-med",
      dark: "bg-black text-white border border-gray-dark",
      ghost: "bg-transparent border-0",
    },
  },
  defaultVariants: {
    size: "default",
    variant: "default",
  },
});

const { class: className, size, variant, ...rest } = Astro.props;
---

<div
  class={card({ size, variant, class: className })}
  data-slot="card"
  data-size={size ?? "default"}
  data-variant={variant ?? "default"}
  {...rest}
>
  <slot />
</div>
