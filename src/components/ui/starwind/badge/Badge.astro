---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

interface Props
  extends HTMLAttributes<"div">, Omit<HTMLAttributes<"a">, "type">, VariantProps<typeof badge> {}

export const badge = tv({
  base: [
    "starwind-badge inline-flex items-center gap-1.5 rounded-sm font-medium whitespace-nowrap uppercase text-xs tracking-wide",
    "[&_svg]:pointer-events-none [&_svg]:shrink-0",
    "transition-all outline-none focus-visible:ring-2",
  ],
  variants: {
    variant: {
      default: "bg-black text-white focus-visible:ring-black/50",
      primary: "bg-gray-dark text-white focus-visible:ring-gray-dark/50",
      secondary: "bg-gray-med text-black focus-visible:ring-gray-med/50",
      outline: "border border-gray-light text-black focus-visible:ring-black/50",
      ghost: "bg-cream text-black focus-visible:ring-black/50",
      info: "bg-gray-light text-black focus-visible:ring-gray-dark/50",
      success: "bg-black text-white focus-visible:ring-black/50",
      warning: "bg-gray-light text-black focus-visible:ring-gray-dark/50",
      error: "bg-black text-white focus-visible:ring-black/50",
    },
    size: {
      sm: "px-2.5 py-0.5 text-xs [&_svg:not([class*='size-'])]:size-3",
      md: "px-3 py-0.5 text-sm [&_svg:not([class*='size-'])]:size-4",
      lg: "px-4 py-1 text-base [&_svg:not([class*='size-'])]:size-4.5",
    },
    isLink: { true: "cursor-pointer", false: "" },
  },
  compoundVariants: [
    { isLink: true, variant: "default", className: "hover:bg-gray-dark" },
    { isLink: true, variant: "primary", className: "hover:bg-gray-dark/80" },
    { isLink: true, variant: "secondary", className: "hover:bg-gray-med/80" },
    { isLink: true, variant: "outline", className: "hover:border-gray-med" },
    { isLink: true, variant: "ghost", className: "hover:bg-gray-light/30" },
    { isLink: true, variant: "info", className: "hover:bg-gray-light/80" },
    { isLink: true, variant: "success", className: "hover:bg-gray-dark/80" },
    { isLink: true, variant: "warning", className: "hover:bg-gray-light/80" },
    { isLink: true, variant: "error", className: "hover:bg-gray-dark/80" },
  ],
  defaultVariants: { variant: "default", size: "md", isLink: false },
});

const { variant, size, class: className, ...rest } = Astro.props;
const isLink = Astro.props.href ? true : false;
const Tag = Astro.props.href ? "a" : "div";
---

<Tag class={badge({ variant, size, isLink, class: className })} data-slot="badge" {...rest}>
  <slot />
</Tag>
