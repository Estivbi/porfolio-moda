---
// components/sections/Contact.astro - Sección de contacto elegante
const contactInfo = [
  {
    label: 'Email',
    value: 'hola@Patricia.com',
    href: 'mailto:hola@Patricia.com'
  },
  {
    label: 'Ubicación',
    value: 'Madrid, España',
    href: '#'
  }
];
---

<section id="contacto" style="background-color: #F5F5F5;" class="py-20 md:py-32">
  <div class="container-moda px-6 md:px-12 max-w-4xl mx-auto">
    <div class="max-w-4xl mx-auto">
      <div class="mb-20">
        <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">Contacto</p>
        <h2 class="font-serif text-5xl md:text-6xl font-light mb-8 leading-tight" style="color: #000000;">
          Hablemos
        </h2>
        <p class="text-lg leading-relaxed max-w-2xl" style="color: #808080; text-align: justify;">
          ¿Tienes un proyecto en mente? Me encantaría conocer tu visión y explorar cómo podemos trabajar juntos para crear algo especial.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Información de contacto -->
        <div class="space-y-12">
          {contactInfo.map((info) => (
            <div style="border-bottom: 1px solid #E8E8E8;" class="pb-8">
              <p class="text-xs uppercase tracking-widest mb-3" style="color: #808080; letter-spacing: 0.1em;">{info.label}</p>
              {info.href !== '#' ? (
                <a 
                  href={info.href} 
                  class="font-serif text-2xl transition-colors" 
                  style="color: #000000;"
                  onmouseover="this.style.color='#808080'"
                  onmouseout="this.style.color='#000000'"
                >
                  {info.value}
                </a>
              ) : (
                <p class="font-serif text-2xl" style="color: #000000;">{info.value}</p>
              )}
            </div>
          ))}

          <!-- Redes sociales -->
          <div>
            <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">Sígueme</p>
            <div class="flex space-x-4">
              <a href="#" class="w-12 h-12 border transition-colors" style="border-color: #000000; color: #000000;" onmouseover="this.style.backgroundColor='#000000'; this.style.color='#FFFFFF'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#000000'">
                <svg class="w-full h-full p-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z" />
                </svg>
              </a>
              <a href="#" class="w-12 h-12 border transition-colors" style="border-color: #000000; color: #000000;" onmouseover="this.style.backgroundColor='#000000'; this.style.color='#FFFFFF'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#000000'">
                <svg class="w-full h-full p-2" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286z" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Mensaje -->
        <div style="background-color: #FFFFFF;" class="p-8 md:p-12">
          <p class="font-serif text-2xl mb-8 leading-tight" style="color: #000000;">
            "La creatividad es la inteligencia divirtiéndose."
          </p>
          <p class="text-sm uppercase tracking-widest mb-8" style="color: #808080; letter-spacing: 0.1em;">— Albert Einstein</p>
          
          <div class="mt-8">
            <a href="mailto:hola@patricia.com?subject=Consulta sobre proyecto" class="block w-full px-8 py-4 text-center transition-colors border-2 font-medium tracking-wide text-sm" style="background-color: #000000; color: #FFFFFF; border-color: #000000;" onmouseover="this.style.backgroundColor='#808080'; this.style.borderColor='#808080'" onmouseout="this.style.backgroundColor='#000000'; this.style.borderColor='#000000'">
              Enviar Mensaje
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
