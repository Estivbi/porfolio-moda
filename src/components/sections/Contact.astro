---
// components/sections/Contact.astro - Sección de contacto elegante
const contactInfo = [
  {
    label: 'Email',
    value: 'mocreativedirection@gmail.com',
    href: 'mailto:mocreativedirection@gmail.com'
  },
  {
    label: 'Ubicación',
    value: 'Madrid, España',
    href: '#'
  }
];
---

<section id="contacto" style="background-color: #F5F5F5;" class="py-20 md:py-32">
  <div class="container-moda px-6 md:px-12 max-w-4xl mx-auto">
    <div class="max-w-4xl mx-auto">
      <div class="mb-20">
        <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">Contacto</p>
        <h2 class="font-serif text-5xl md:text-6xl font-light mb-8 leading-tight" style="color: #000000;">
          Hablemos
        </h2>
        <p class="text-lg leading-relaxed max-w-2xl" style="color: #808080; text-align: justify;">
          ¿Tienes un proyecto en mente? Me encantaría conocer tu visión y explorar cómo podemos trabajar juntos para crear algo especial.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16">
        <!-- Información de contacto -->
        <div class="space-y-12">
          {contactInfo.map((info) => (
            <div style="border-bottom: 1px solid #E8E8E8;" class="pb-8">
              <p class="text-xs uppercase tracking-widest mb-3" style="color: #808080; letter-spacing: 0.1em;">{info.label}</p>
              {info.href !== '#' ? (
                <a 
                  href={info.href} 
                  class="font-serif text-2xl transition-colors" 
                  style="color: #000000;"
                  onmouseover="this.style.color='#808080'"
                  onmouseout="this.style.color='#000000'"
                >
                  {info.value}
                </a>
              ) : (
                <p class="font-serif text-2xl" style="color: #000000;">{info.value}</p>
              )}
            </div>
          ))}

          <!-- Redes sociales -->
          <div>
            <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">Sígueme</p>
            <div class="flex space-x-4">
              <!-- Instagram -->
              <a href="https://instagram.com/patricia.moreeno" target="_blank" rel="noopener noreferrer" class="w-12 h-12 border transition-colors flex items-center justify-center" style="border-color: #000000; color: #000000;" onmouseover="this.style.backgroundColor='#000000'; this.style.color='#FFFFFF'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#000000'">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z"/>
                  <circle cx="17.5" cy="6.5" r="1.5"/>
                </svg>
              </a>
              <!-- TikTok -->
              <a href="https://tiktok.com/@patricia.moreeno" target="_blank" rel="noopener noreferrer" class="w-12 h-12 border transition-colors flex items-center justify-center" style="border-color: #000000; color: #000000;" onmouseover="this.style.backgroundColor='#000000'; this.style.color='#FFFFFF'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#000000'">
                <svg class="w-6 h-6" viewBox="0 0 352.28 398.67" fill="currentColor">
                  <path d="M137.17 156.98v-15.56c-5.34-.73-10.76-1.18-16.29-1.18C54.23 140.24 0 194.47 0 261.13c0 40.9 20.43 77.09 51.61 98.97-20.12-21.6-32.46-50.53-32.46-82.31 0-65.7 52.69-119.28 118.03-120.81Z"/>
                  <path d="M140.02 333c29.74 0 54-23.66 55.1-53.13l.11-263.2h48.08c-1-5.41-1.55-10.97-1.55-16.67h-65.67l-.11 263.2c-1.1 29.47-25.36 53.13-55.1 53.13-9.24 0-17.95-2.31-25.61-6.34C105.3 323.9 121.6 333 140.02 333ZM333.13 106V91.37c-18.34 0-35.43-5.45-49.76-14.8 12.76 14.65 30.09 25.22 49.76 29.43Z"/>
                  <path d="M283.38 76.57c-13.98-16.05-22.47-37-22.47-59.91h-17.59c4.63 25.02 19.48 46.49 40.06 59.91ZM120.88 205.92c-30.44 0-55.21 24.77-55.21 55.21 0 21.2 12.03 39.62 29.6 48.86-6.55-9.08-10.45-20.18-10.45-32.2 0-30.44 24.77-55.21 55.21-55.21 5.68 0 11.13.94 16.29 2.55v-67.05c-5.34-.73-10.76-1.18-16.29-1.18-.96 0-1.9.05-2.85.07v51.49c-5.16-1.61-10.61-2.55-16.29-2.55Z"/>
                  <path d="M333.13 106v51.04c-34.05 0-65.61-10.89-91.37-29.38v133.47c0 66.66-54.23 120.88-120.88 120.88-25.76 0-49.64-8.12-69.28-21.91 22.08 23.71 53.54 38.57 88.42 38.57 66.66 0 120.88-54.23 120.88-120.88V144.33c25.76 18.49 57.32 29.38 91.37 29.38v-65.68c-6.57 0-12.97-.71-19.14-2.03Z"/>
                  <path d="M241.76 261.13V127.66c25.76 18.49 57.32 29.38 91.37 29.38V106c-19.67-4.21-37-14.77-49.76-29.43-20.58-13.42-35.43-34.88-40.06-59.91h-48.08l-.11 263.2c-1.1 29.47-25.36 53.13-55.1 53.13-18.42 0-34.72-9.1-44.75-23.01-17.57-9.25-29.6-27.67-29.6-48.86 0-30.44 24.77-55.21 55.21-55.21 5.68 0 11.13.94 16.29 2.55v-51.49C71.83 158.5 19.14 212.08 19.14 277.78c0 31.78 12.34 60.71 32.46 82.31C71.23 373.87 95.12 382 120.88 382c66.65 0 120.88-54.23 120.88-120.88Z"/>
                </svg>
              </a>
            </div>

            <!-- Brand Info -->
            <div class="mt-12 pt-8" style="border-top: 1px solid #E8E8E8;">
              <p class="text-xs uppercase tracking-widest mb-3" style="color: #808080; letter-spacing: 0.1em;">Brand</p>
              <h3 class="font-serif text-xl mb-2" style="color: #000000;">Mo Creative Direction</h3>
              <p class="text-sm" style="color: #808080;">Direction & Stylist</p>
            </div>
          </div>
        </div>

        <!-- Mensaje -->
        <div style="background-color: #FFFFFF;" class="p-8 md:p-12 flex flex-col justify-center aspect-square">
          <p class="font-serif text-2xl mb-8 leading-tight" style="color: #000000;">
            "La creatividad es la inteligencia divirtiéndose."
          </p>
          <p class="text-sm uppercase tracking-widest mb-8" style="color: #808080; letter-spacing: 0.1em;">— Albert Einstein</p>
          
          <div class="mt-8">
            <a href="mailto:mocreativedirection@gmail.com?subject=Consulta sobre proyecto" class="block w-full px-8 py-4 text-center transition-colors border-2 font-medium tracking-wide text-sm" style="background-color: #000000; color: #FFFFFF; border-color: #000000;" onmouseover="this.style.backgroundColor='#808080'; this.style.borderColor='#808080'" onmouseout="this.style.backgroundColor='#000000'; this.style.borderColor='#000000'">
              Enviar Mensaje
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
