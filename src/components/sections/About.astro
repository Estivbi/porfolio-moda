---
// components/sections/About.astro - Sección educación y habilidades
import { useTranslations } from '../../i18n/ui.js';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="educacion" style="background-color: #FFFFFF;" class="py-20 md:py-32">
  <div class="container-moda px-6 md:px-12 max-w-4xl mx-auto">
    <!-- Educación -->
    <div class="mb-24">
      <div class="max-w-4xl">
        <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">{t.educationEyebrow}</p>
        <h2 class="font-serif text-4xl md:text-5xl font-light mb-12 leading-tight" style="color: #000000;">
          {t.educationTitle}
        </h2>

        <div class="space-y-8" style="color: #808080; line-height: 1.8; font-size: 1.05rem; text-align: justify;">
          {t.education.map((paragraph) => <p set:html={paragraph} />)}
        </div>
      </div>
    </div>

    <!-- Habilidades -->
    <div id="habilidades" style="border-top: 1px solid #E8E8E8; padding-top: 32px;">
      <div class="max-w-4xl">
        <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">{t.skillsEyebrow}</p>
        <h2 class="font-serif text-4xl md:text-5xl font-light mb-12 leading-tight" style="color: #000000;">
          {t.skillsTitle}
        </h2>

        <div class="grid md:grid-cols-2 gap-8">
          {t.skillGroups.map((group, i) => (
            <div>
              <h4 class="font-serif text-lg mb-4" style="color: #000000;">{group}</h4>
              <ul class="space-y-3" style="color: #808080; line-height: 1.8;">
                {t.skills[i].map((skill) => <li>• {skill}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
