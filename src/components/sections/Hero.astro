---
// components/sections/Hero.astro - Sección hero minimalista y elegante
---

<section id="inicio" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-24" style="background-color: #FFFFFF;">
  <div class="container-moda relative z-10 px-6 md:px-12 max-w-4xl mx-auto">
    <div>
      <!-- Subtítulo -->
      <p class="text-xs tracking-widest uppercase mb-12 fade-in" style="color: #808080; letter-spacing: 0.15em;">Estilista & Directora Creativa</p>

      <!-- Nombre principal -->
      <h1 class="mb-8 slide-up font-light" style="animation-delay: 0.2s; font-size: clamp(3.5rem, 12vw, 7rem); line-height: 1.1; font-family: 'Playfair Display', serif; color: #000000;">
        Patricia Moreno
      </h1>

      <!-- Descripción -->
      <p class="text-lg md:text-xl max-w-3xl mb-16 leading-relaxed slide-up font-light" style="animation-delay: 0.4s; color: #808080;">
        Tengo 21 años y soy estilista y directora creativa. Especializada en desarrollo de conceptos creativos, dirección estética y construcción de narrativas visuales para marcas, artistas y editoriales de moda.
      </p>

      <!-- CTA -->
      <div class="flex flex-col sm:flex-row gap-6 slide-up" style="animation-delay: 0.6s;">
        <a href="#proyectos" class="px-8 py-4 transition-colors text-sm font-medium tracking-wide border-2" style="background-color: #000000; color: #FFFFFF; border-color: #000000;" onmouseover="this.style.backgroundColor='#808080'; this.style.borderColor='#808080'" onmouseout="this.style.backgroundColor='#000000'; this.style.borderColor='#000000'">
          Ver Proyectos
        </a>
        <a href="#contacto" class="px-8 py-4 transition-colors text-sm font-medium tracking-wide border-2" style="border-color: #000000; color: #000000;" onmouseover="this.style.backgroundColor='#000000'; this.style.color='#FFFFFF'" onmouseout="this.style.backgroundColor='transparent'; this.style.color='#000000'">
          Contactar
        </a>
      </div>
    </div>
  </div>
</section>
