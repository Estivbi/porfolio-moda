---
// components/sections/Projects.astro - Secciones del portfolio con imagen de fondo
import sections from '../../data/sections.js';
import SectionCard from '../projects/SectionCard.astro';

// Dos tarjetas grandes arriba y tres verticales abajo en escritorio
const layout = [
  'aspect-[4/5] md:aspect-[4/3] lg:col-span-3',
  'aspect-[4/5] md:aspect-[4/3] lg:col-span-3',
  'aspect-[4/5] md:aspect-[3/4] lg:col-span-2',
  'aspect-[4/5] md:aspect-[3/4] lg:col-span-2',
  'aspect-[4/5] md:aspect-[4/3] md:col-span-2 lg:col-span-2 lg:aspect-[3/4]',
];
---

<section id="proyectos" style="background-color: #F5F5F5;" class="py-20 md:py-32">
  <div class="container-moda px-6 md:px-12 max-w-6xl mx-auto">
    <!-- Encabezado -->
    <div class="max-w-4xl mb-20">
      <p class="text-xs uppercase tracking-widest mb-6" style="color: #808080; letter-spacing: 0.1em;">Proyectos</p>
      <h2 class="font-serif text-5xl md:text-6xl font-light mb-10 leading-tight" style="color: #000000;">
        Trabajos Destacados
      </h2>
      <p class="text-lg leading-relaxed" style="color: #808080;">
        Selección de proyectos donde he participado como estilista y directora creativa
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-6 gap-4 lg:gap-6">
      {sections.map((section, index) => (
        <SectionCard section={section} index={index} class={layout[index % layout.length]} />
      ))}
    </div>
  </div>
</section>
